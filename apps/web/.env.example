# Copia este archivo a `.env` para arrancar en local con el Emulator Suite.
# Vite carga las variables `VITE_*` al arrancar (`npm run dev`).
#
# En local SIEMPRE con "true": sin esto la web apunta al proyecto real de
# Firebase en vez de a los emuladores y el login falla con "correo o
# contraseña incorrectos" (doc 06 §4).
VITE_USE_EMULATORS=true
