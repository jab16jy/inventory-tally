{
  "name": "inventory-tally",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "contracts",
    "tools"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "emu": "firebase emulators:start",
    "seed": "npm run seed --workspace tools --if-present",
    "test:rules": "firebase emulators:exec --project demo-conteo-eficiente --only firestore,auth \"vitest run infra/test\"",
    "test:e2e": "firebase emulators:exec --project demo-conteo-eficiente --only auth,firestore \"npm run seed --workspace tools && npm run test:e2e --workspace apps/web\""
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.0.0",
    "firebase": "^11.10.0",
    "firebase-admin": "^12.7.0",
    "firebase-tools": "^13.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
